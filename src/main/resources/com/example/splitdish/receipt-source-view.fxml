<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="390.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.splitdish.ReceiptSourceController">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" spacing="15.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="30.0">
         <children>
            <Label text="Choose Receipt" />
            <Button mnemonicParsing="false" onAction="#onUploadClick" prefHeight="25.0" prefWidth="146.0" text="Upload from Computer" />
            <Button disable="true" mnemonicParsing="false" text="Use Camera" />
            <ImageView fx:id="receiptImageView" fitHeight="447.0" fitWidth="330.0" pickOnBounds="true" preserveRatio="true" />
            <Button fx:id="continueButton" disable="true" mnemonicParsing="false" onAction="#onContinueClick" text="Continue" />
         </children>
      </VBox>
   </children>
</AnchorPane>
